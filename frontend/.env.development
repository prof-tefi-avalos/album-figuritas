# Variables que Vite carga con npm run dev (en el build de Vercel, NO: allá se
# configuran en el panel del proyecto). Si cambiás este archivo, reiniciá npm run dev.
#
# Solo las que empiezan con VITE_ llegan al código del navegador
# (import.meta.env.VITE_...). Por eso mismo, acá NUNCA va nada secreto.

VITE_API_URL=http://localhost:3000/api
